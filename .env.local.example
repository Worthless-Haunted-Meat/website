# Copy this to .env.local and fill in the values
# NEVER commit .env.local to git

# Resend API key — get from resend.com
RESEND_API_KEY=re_...

# Board portal password protection
# Generate these by running:
# node -e "const {createHash}=require('crypto'); const salt='your_random_salt'; const pw='your_password'; console.log('BOARD_PASSWORD_SALT='+salt); console.log('BOARD_TOKEN_HASH='+createHash('sha256').update(pw+salt).digest('hex'))"
BOARD_PASSWORD_SALT=your_random_salt_here
BOARD_TOKEN_HASH=sha256_hex_hash_here
